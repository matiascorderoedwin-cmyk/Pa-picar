# Copia este archivo como .env y edita los valores solamente en tu equipo o servidor.
# NUNCA subas .env, claves ni contraseñas reales a GitHub.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=base_de_pa-picar
DATABASE_USER=postgres
DATABASE_PASSWORD=REEMPLAZAR_CON_CONTRASENA_PRIVADA
# Genera una clave aleatoria larga para conservar las sesiones al reiniciar.
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_LARGA
# Activa true exclusivamente cuando la aplicación se sirva mediante HTTPS.
COOKIE_SECURE=false
