# Local development: copy to .env and fill in private values. Never commit .env.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=base_de_pa-picar
DATABASE_USER=postgres
DATABASE_PASSWORD=REPLACE_LOCALLY
DATABASE_SSLMODE=prefer
DATABASE_POOLER=false
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
COOKIE_SECURE=false

# Vercel + Supabase: configure these in Vercel project environment variables,
# not in this file or GitHub. Use Supabase Connect > Transaction pooler details.
# DATABASE_HOST=<pooler hostname>
# DATABASE_PORT=6543
# DATABASE_NAME=postgres
# DATABASE_USER=<pooler username from Supabase>
# DATABASE_PASSWORD=<database password>
# DATABASE_SSLMODE=require
# DATABASE_POOLER=true
# SECRET_KEY=<stable random secret>
# COOKIE_SECURE=true
